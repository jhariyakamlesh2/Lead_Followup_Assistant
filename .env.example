# Copy this file to .env and add your own Anthropic API key.
# Never commit .env or share its contents.
ANTHROPIC_API_KEY= 
ANTHROPIC_MODEL=claude-sonnet-4-5
DATABASE_PATH=data/lead_assistant.db

# Email sending is optional. Configure a real SMTP provider to enable it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls
